---
import type { CollectionEntry } from "astro:content";
import ProjectCard from "../ProjectCard.astro";
interface Props {
  label: string;
  projects: CollectionEntry<"proyectos">[];
}
const { label, projects } = Astro.props;
---

<section class="animate-panel-in motion-reduce:animate-none">
  <h2 class="sr-only">{label}</h2>
  <ul class="grid grid-cols-1 gap-x-4 gap-y-10 pb-10 md:grid-cols-2 md:gap-x-6 md:gap-y-14">
    {projects.map((project, i) => <li class="min-w-0"><ProjectCard project={project} variant="home" priority={i === 0} /></li>)}
  </ul>
</section>
