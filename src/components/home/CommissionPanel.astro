---
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
interface Props {
  entry: CollectionEntry<"aPedido">;
}
const { entry } = Astro.props;
const { eyebrow, title, subtitle, intro, groups, note, image, imageMobile } = entry.data;

// Imagen decorativa: <picture> con recorte mobile (< 810px) y versión desktop.
const W = 400;
const variants = async (img: NonNullable<typeof image>) => ({
  avif: await getImage({ src: img.src, format: "avif", width: W }),
  webp: await getImage({ src: img.src, format: "webp", width: W }),
});
const desk = image ? await variants(image) : undefined;
const mob = imageMobile ? await variants(imageMobile) : undefined;

const tile = "rounded-tile p-5";
---

<section class="animate-panel-in motion-reduce:animate-none">
  <div class="pb-[52px] pt-[30px] lg:pb-[62px] lg:pt-10 flex flex-col gap-[18px]">
    <h2 class="text-h3">{eyebrow}</h2>
    <div
      class="grid grid-cols-2 gap-x-3 gap-y-[18px] md:flex md:max-w-[753px] md:flex-col lg:max-w-[1152px]"
    >
      <div class="contents md:grid md:h-[176px] md:grid-cols-[225fr_329fr_176fr] md:gap-3 lg:h-auto lg:min-h-[185px] lg:grid-cols-[345fr_576fr_207fr]">
        <div
          class:list={[tile, "order-1 flex flex-col bg-accent-2 text-stat-sm text-white lg:justify-center lg:text-stat md:order-none"]}
        >
          <p>{title}</p>
          <p class="mt-5">{subtitle}</p>
        </div>
        <p
          class:list={[tile, "order-3 col-span-2 bg-card-warm text-stat-sm md:order-none md:col-span-1 md:bg-card md:px-[15px] lg:flex lg:items-center lg:px-6 lg:text-stat"]}
        >
          {intro}
        </p>
        {
          desk && (
            <div class:list={[tile, "relative order-2 min-h-0 bg-card-warm md:order-none"]}>
              <picture class="absolute inset-5 block">
                {mob && (
                  <>
                    <source media="(max-width: 809.98px)" srcset={mob.avif.src} type="image/avif" />
                    <source media="(max-width: 809.98px)" srcset={mob.webp.src} type="image/webp" />
                  </>
                )}
                <source srcset={desk.avif.src} type="image/avif" />
                <source srcset={desk.webp.src} type="image/webp" />
                <img
                  src={desk.webp.src}
                  alt={image!.alt}
                  width={desk.webp.attributes.width}
                  height={desk.webp.attributes.height}
                  loading="lazy"
                  decoding="async"
                  class="size-full rounded-[inherit] object-cover"
                />
              </picture>
            </div>
          )
        }
      </div>
      <div class="contents md:grid md:grid-cols-[264fr_473fr] md:gap-x-4 md:gap-y-[18px] lg:min-h-[185px] lg:grid-cols-[345fr_576fr_198fr]">
        {
          groups.map((g, i) => (
            <div
              class:list={[
                tile,
                i === 0 ? "order-4" : "order-5",
                "col-span-2 flex md:h-[187px] lg:h-auto flex-col bg-card md:order-none md:col-span-1 lg:justify-center",
                g.items?.length ? "gap-3 lg:gap-2.5" : "gap-2.5",
              ]}
            >
              <h3 class="text-label">{g.title}</h3>
              {g.items?.length ? (
                <ul class="flex flex-col gap-3 text-caption lg:gap-2.5">
                  {g.items.map((item) => <li>{item}</li>)}
                </ul>
              ) : null}
              {g.text && <p class="text-caption">{g.text}</p>}
              {i === groups.length - 1 && note && <p class="mt-2.5 text-caption">{note}</p>}
            </div>
          ))
        }
      <div
        class="star order-6 col-span-2 h-11 overflow-hidden rounded-tile-sm bg-accent p-1 md:order-none md:col-span-2 md:h-[45px] md:rounded-xl lg:col-span-1 lg:h-auto lg:rounded-tile lg:p-3"
        aria-hidden="true"
      ></div>
      </div>

    </div>
  </div>
</section>
