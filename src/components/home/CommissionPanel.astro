---
import { getImage } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import site from "../../data/site.json";
interface Props {
  entry: CollectionEntry<"aPedido">;
}
const { entry } = Astro.props;
const { eyebrow, title, subtitle, intro, groups, note, image, imageMobile } = entry.data;

// Imagen decorativa: <picture> con recorte mobile (< 810px) y versión desktop.
const W = 400;
const variants = async (img: NonNullable<typeof image>) => ({
  avif: await getImage({ src: img.src, format: "avif", width: W }),
  webp: await getImage({ src: img.src, format: "webp", width: W }),
});
const desk = image ? await variants(image) : undefined;
const mob = imageMobile ? await variants(imageMobile) : undefined;

const tile = "rounded-tile p-5";
---

<section class="animate-panel-in motion-reduce:animate-none">
  <div class="pb-13 lg:pb-15.5 lg:pt-0 flex flex-col gap-[18px]">
    <h2 class="text-h3">{eyebrow}</h2>
    <div
      class="grid grid-cols-2 gap-x-3 gap-y-[18px] md:flex md:max-w-[753px] md:flex-col lg:max-w-[1152px]"
    >
      <div class="contents md:grid md:min-h-[176px] md:grid-cols-[225fr_329fr_176fr] md:gap-3 lg:h-auto lg:min-h-[185px] lg:grid-cols-[345fr_576fr_207fr]">
        <div
          class:list={[tile, "order-1 flex flex-col justify-between gap-4 bg-violet text-white md:order-none lg:justify-center"]}
        >
          <p class="text-stat-sm lg:text-stat">{title}</p>
          <p class="text-body text-white/80">{subtitle}</p>
        </div>
        <p
          class:list={[tile, "order-3 col-span-2 flex items-center bg-card-warm text-lead text-ink-2 md:order-none md:col-span-1 md:bg-card md:px-[15px] md:text-body-lg lg:px-6 lg:text-lead-lg"]}
        >
          <span>
            {intro.split(/(?=Me gusta)/).map((part, i) => (i > 0 ? <><br class="lg:hidden" />{part}</> : part))}
          </span>
        </p>
        {
          desk && (
            <div class:list={[tile, "relative order-2 min-h-0 bg-card-warm md:order-none"]}>
              <picture class="absolute inset-5 block">
                {mob && (
                  <>
                    <source media="(max-width: 809.98px)" srcset={mob.avif.src} type="image/avif" />
                    <source media="(max-width: 809.98px)" srcset={mob.webp.src} type="image/webp" />
                  </>
                )}
                <source srcset={desk.avif.src} type="image/avif" />
                <source srcset={desk.webp.src} type="image/webp" />
                <img
                  src={desk.webp.src}
                  alt={image!.alt}
                  width={desk.webp.attributes.width}
                  height={desk.webp.attributes.height}
                  loading="lazy"
                  decoding="async"
                  class="size-full rounded-[inherit] object-cover"
                />
              </picture>
            </div>
          )
        }
      </div>
      <div class="contents md:grid md:grid-cols-[264fr_473fr] md:gap-x-3 md:gap-y-3 lg:grid-cols-[300fr_500fr_328fr]">
        {
          groups.map((g, i) => (
            <div
              class:list={[
                tile,
                i === 0 ? "order-4" : "order-5",
                "col-span-2 flex flex-col gap-4 bg-card md:order-none md:col-span-1",
              ]}
            >
              <h3 class="text-h4 text-ink">{g.title}</h3>
              {g.items?.length ? (
                <ul class="flex flex-col gap-2.5 text-label text-ink">
                  {g.items.map((item) => <li class="flex items-center gap-2.5 before:size-1.5 before:shrink-0 before:rounded-full before:bg-violet before:content-['']">{item}</li>)}
                </ul>
              ) : null}
              {g.text && <p class="text-body text-ink-2">{g.text}</p>}
              {i === groups.length - 1 && note && <p class="mt-auto text-caption text-ink-3">{note}</p>}
            </div>
          ))
        }
      <div
        class:list={[tile, "order-6 col-span-2 flex flex-col gap-5 bg-[#f36f4a] text-ink md:order-none md:col-span-2 md:flex-row md:items-end md:justify-between lg:col-span-1 lg:flex-col lg:items-stretch lg:justify-between"]}
      >
        <div class="flex flex-col gap-2">
          <span aria-hidden="true" class="block h-[0.4em] w-[0.5em] font-serif italic text-star text-[#a457d8] lg:text-display-serif leading-[0.75]">*</span>
          <a href={`mailto:${site.email}`} class="text-[36px] leading-[1.04] tracking-[-0.04em] font-medium md:text-[33px] break-all text-ink underline-offset-4 hover:underline">{site.email}</a>
        </div>
        <a
          href={`mailto:${site.email}`}
          class="bg-ink text-ink-inverse shadow-btn inline-flex h-11 shrink-0 items-center justify-center rounded-btn px-5 text-ui-lg leading-none font-medium transition duration-300 hover:-translate-y-0.5 hover:brightness-125 active:translate-y-0 active:scale-[0.96] active:brightness-90 motion-reduce:transition-none motion-reduce:transform-none"
        >{site.cta.label}</a>
      </div>
      </div>

    </div>
  </div>
</section>
