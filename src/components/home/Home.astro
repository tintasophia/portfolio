---
/* Contenido de una página de la home entre el header y el footer: hero + barra de pestañas +
   el panel de esa página. Cada pestaña es una página (/, /sobre-mi/, /a-pedido/); el cambio
   entre ellas se anima con view transitions entre documentos (solo CSS, ver global.css).
   Uso: <Home active="trabajos" /> en src/pages/index.astro (y sobre-mi, a-pedido). Cero JS. */
import { getEntry } from "astro:content";
import { getProyectosOrdenados } from "../../lib/proyectos";
import { getTabs, type TabKey } from "../../lib/tabs";
import Hero from "./Hero.astro";
import Tabs from "./Tabs.astro";
import WorksPanel from "./WorksPanel.astro";
import AboutPanel from "./AboutPanel.astro";
import CommissionPanel from "./CommissionPanel.astro";

interface Props {
  active: TabKey;
}
const { active } = Astro.props;
const hero = await getEntry("hero", "hero");
if (!hero) throw new Error("Falta contenido en src/content/home");
const tabs = await getTabs();
// solo el contenido del panel de esta página
const projects = active === "trabajos" ? await getProyectosOrdenados() : [];
const about = active === "sobreMi" ? await getEntry("sobreMi", "sobre-mi") : undefined;
const commission = active === "aPedido" ? await getEntry("aPedido", "a-pedido") : undefined;
if ((active === "sobreMi" && !about) || (active === "aPedido" && !commission)) throw new Error("Falta contenido en src/content/home");
---

<Hero title={hero.data.title} tagline={hero.data.tagline} />
<Tabs tabs={tabs} active={active}>
  {active === "trabajos" && <WorksPanel label={hero.data.tabs.trabajos} projects={projects} />}
  {about && <AboutPanel entry={about} />}
  {commission && <CommissionPanel entry={commission} />}
</Tabs>
