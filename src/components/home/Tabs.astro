---
/* Barra de pestañas de la home. Cada pestaña es un link a su página; la activa lleva
   aria-current="page" (de ahí salen el color y la pill, ver home.css).
   - Los links llegan al ancla #contenido (justo sobre la barra, scroll-mt = top del sticky): la
     página nueva se abre con la barra arriba y su contenido a la vista, no desde el principio.
   - La barra, la pill y cada pestaña tienen view-transition-name: al navegar, la pill se desliza
     a la nueva pestaña por debajo de los textos (cada link es su propia capa, pintada después
     de la pill) y la barra no se mueve (global.css). */
import { CONTENT_ANCHOR, tabHref, type Tab, type TabKey } from "../../lib/tabs";

interface Props {
  tabs: Tab[];
  active: TabKey;
}
const { tabs, active } = Astro.props;
---

<div class="tabs">
  <span id={CONTENT_ANCHOR} class="block h-0 scroll-mt-4" aria-hidden="true"></span>
  <div class="sticky top-4 z-10 flex h-[50px] justify-center">
    <nav
      aria-label="Secciones"
      class="tabbar relative inline-flex mt-1 h-fit items-center rounded-pill bg-glass p-[5px] shadow-tabbar backdrop-blur-[16px] backdrop-saturate-[1.6]"
    >
      <span class="tab-pill" aria-hidden="true"></span>
      {
        tabs.map((t) => (
          <a
            href={tabHref(t)}
            aria-current={t.key === active ? "page" : undefined}
            style={`view-transition-name: tab-${t.key}`}
            class="tab-link relative z-[1] whitespace-nowrap rounded-pill px-2.5 py-[7px] text-ui-sm leading-[1.2] font-medium transition-colors duration-[350ms] ease-soft outline-offset-2 focus-visible:outline-2 focus-visible:outline-violet md:px-4 md:py-2 md:text-ui-lg"
          >
            {t.label}
          </a>
        ))
      }
    </nav>
  </div>
  <div class="mx-auto w-full max-w-[1232px] px-5 pt-8 md:px-6 md:pt-12">
    <slot />
  </div>
</div>
