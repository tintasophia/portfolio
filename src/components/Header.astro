---
import { url } from "../lib/url";
import site from "../data/site.json";
---
<header class="site-header mx-auto flex w-full max-w-308 items-center justify-between px-5 pt-6 md:px-6 md:pt-10">
  <a href={url()} class="text-brand text-ink">{site.name}</a>
  <a
    href={`mailto:${site.email}`}
    class="bg-ink text-ink-inverse shadow-btn inline-flex h-8.5 items-center rounded-btn-sm px-3 text-ui-sm leading-none font-medium transition duration-300 hover:-translate-y-0.5 hover:brightness-125 active:translate-y-0 active:scale-[0.96] active:brightness-90 motion-reduce:transition-none motion-reduce:transform-none md:h-9.5 md:rounded-btn-md md:px-3.5 md:text-ui"
  >{site.cta.label}</a>
</header>
