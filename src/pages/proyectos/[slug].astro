---
import { getProyectosOrdenados } from "../../lib/proyectos";
import Img from "../../components/Img.astro";
import { marked } from "marked";
import Base from "../../layouts/Base.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import site from "../../data/site.json";

export async function getStaticPaths() {
  const all = await getProyectosOrdenados();
  return all.map((project) => ({
    params: { slug: project.id },
    props: { project, related: all.filter((p) => p.id !== project.id).slice(0, 2) },
  }));
}
const { project, related } = Astro.props;
const d = project.data;
const t = site.projectPage;
const sizes = "(min-width: 1232px) 1184px, 100vw";
const pairSizes = "(min-width: 1232px) 584px, (min-width: 810px) 48vw, 100vw";
const firstImage = d.blocks.findIndex((b) => b.type !== "text");
---
<Base title={`${d.title} — ${site.name}`} description={d.description} image={d.cover.src}>
  <article class="mx-auto w-full max-w-308 px-5 md:px-6">
    <header class="flex flex-col gap-4.5 pt-12 md:gap-5.5 md:pt-18">
      <span class="text-caption bg-soft w-fit rounded-pill px-3 py-1.25">{d.category}</span>
      <h1 class="text-h1-sm md:text-h1 max-w-200">{d.title}</h1>
      <p class="text-lead md:text-lead-lg w-full max-w-190 md:w-[91%] lg:w-[59%]">{d.intro}</p>
      <dl class="border-line flex flex-col gap-3.5 border-t pt-6 md:flex-row md:gap-5.5 lg:gap-5">
        <div class="flex flex-col gap-1 md:w-[12%] lg:w-[95px]">
          <dt class="text-caption text-ink-2">{t.yearLabel}</dt>
          <dd class="text-label">{d.year}</dd>
        </div>
        <div class="flex flex-col gap-1">
          <dt class="text-caption text-ink-2">{t.servicesLabel}</dt>
          <dd class="text-label">{d.services.join(", ")}</dd>
        </div>
      </dl>
    </header>

    {d.blocks.map((b, i) => {
      // La primera imagen de la página carga con prioridad (LCP); el resto, lazy.
      const priority = i === firstImage;
      const loading = priority ? ("eager" as const) : ("lazy" as const);
      const fetchpriority = priority ? ("high" as const) : undefined;
      if (b.type === "hero") {
        return (
          <div class="pt-9 md:pt-14">
            <div class="bg-media relative aspect-video overflow-clip rounded-hero-sm md:rounded-hero">
              <Img src={b.image.src} alt={b.image.alt} widths={[640, 960, 1280, 1800]} sizes={sizes} loading={loading} fetchpriority={fetchpriority} />
            </div>
          </div>
        );
      }
      if (b.type === "text") {
        return (
          <section class="pt-15.5 md:pt-15 lg:pt-18">
            <div class="flex max-w-225 flex-col gap-3">
              <h2 class="text-h4">{b.title}</h2>
              <div class="text-body-lg text-ink-2 flex flex-col gap-4 [&_a]:underline" set:html={marked.parse(b.body.trim()) as string} />
            </div>
          </section>
        );
      }
      if (b.type === "images") {
        return (
          <div class="flex flex-col gap-6 pt-13 md:flex-row md:gap-4 md:pt-15 lg:pt-10">
            {b.images.map((im, j) => (
              <div class="bg-media relative aspect-[4/5] overflow-clip rounded-hero-sm md:flex-1 md:rounded-card">
                <Img src={im.src} alt={im.alt} widths={[480, 720, 960, 1200]} sizes={pairSizes} loading={j === 0 ? loading : "lazy"} fetchpriority={j === 0 ? fetchpriority : undefined} />
              </div>
            ))}
          </div>
        );
      }
      return (
        <div class="pt-13 md:pt-10">
          <div class="bg-media relative h-82.5 overflow-clip rounded-hero-sm md:h-173.5 md:rounded-hero lg:h-200">
            <Img src={b.image.src} alt={b.image.alt} widths={[640, 960, 1280, 1800]} sizes={sizes} loading={loading} fetchpriority={fetchpriority} />
          </div>
        </div>
      );
    })}

    <section class="flex flex-col gap-8 pt-19 pb-13 md:gap-7 md:pt-25 md:pb-19 lg:pt-35">
      <div class="flex flex-col items-center gap-8 md:flex-row md:items-end md:justify-between">
        <h2 class="text-h3">{t.moreTitle}</h2>
        <a href="/#contenido" class="bg-ink text-ink-inverse shadow-btn inline-flex h-8.5 items-center gap-2 rounded-btn-sm px-3 text-ui-sm font-medium transition duration-300 hover:brightness-125 md:h-11 md:rounded-btn md:px-4.5 md:text-ui">{t.moreButton} <svg aria-hidden="true" viewBox="0 0 16 16" class="size-3.5" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg></a>
      </div>
      <div class="grid grid-cols-1 gap-x-4 gap-y-10 md:grid-cols-2 md:gap-x-6 md:gap-y-14">
        {related.map((p) => <ProjectCard project={p} variant="related" />)}
      </div>
    </section>
  </article>
</Base>
